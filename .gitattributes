# Auto detect text files and perform LF normalization
* text=auto

# Windows WPF / .NET Specific Files (CRLF)
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.manifest text eol=crlf
*.iss text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.md text eol=crlf
*.json text eol=crlf

# Binary Files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
