                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Cycles -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="BATTERY TIMELINE" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                            <TextBlock x:Name="TxtCycleStats" Text="Cycles: 14 • Energy Added: 0.0 Wh" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas" FontSize="11"/>
                        </DockPanel>

                        <!-- Battery Timeline Canvas with Integrated Precision Y-Axis Grid & Labels -->
                        <Border Grid.Row="1" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="4" Margin="0,0,0,8">
                            <Canvas x:Name="CanvasBatteryTimeline" Background="Transparent" ClipToBounds="True"/>
                        </Border>

                        <!-- Vitals Bar -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="BATTERY STATE" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                    <TextBlock x:Name="TxtBatteryCharge" Text="75% (AC Connected)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="CHARGE RATE" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                    <TextBlock x:Name="TxtBatteryRate" Text="0.0 W" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="6">
                                <StackPanel>
                                    <TextBlock Text="CAPACITY &amp; HEALTH" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                    <TextBlock x:Name="TxtBatteryCapacityHealth" Text="-- Wh (--% Health)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 5: INTERNET & NETWORK INTERFACES -->
            <Grid x:Name="ViewNetwork" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Vitals Ribbon -->
                    <RowDefinition Height="*"/>    <!-- Split Stage: Graph on Left, Adapters List on Right -->
                </Grid.RowDefinitions>

                <!-- 1. Top Vitals Strip -->
                <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Download Speed (Red) -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL DOWNLOAD (RX)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="TxtNetDownSpeed" Text="0.0 KB/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushMetricRed}" FontFamily="Consolas"/>
                                <TextBlock x:Name="TxtNetDownStats" Text="Peak: 0.0 MB/s • In: 0.0 GB" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Upload Speed (Green) -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL UPLOAD (TX)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="TxtNetUpSpeed" Text="0.0 KB/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushMetricGreen}" FontFamily="Consolas"/>
                                <TextBlock x:Name="TxtNetUpStats" Text="Peak: 0.0 MB/s • Out: 0.0 GB" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <!-- Primary Network Connection -->
                        <Border Grid.Column="2" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="PRIMARY CONNECTION" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="TxtActiveNetName" Text="Wi-Fi" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtActiveNetIp" Text="IPv4: --" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                        <!-- Session Data Transferred -->
                        <Border Grid.Column="3" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="SESSION DATA TRANSFERRED" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="TxtNetDataIn" Text="In: 0.0 GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushMetricRed}" FontFamily="Consolas"/>
                                <TextBlock x:Name="TxtNetDataOut" Text="Out: 0.0 GB" FontSize="10.5" Foreground="{DynamicResource BrushMetricGreen}" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Split Stage: Bandwidth History on Left, Network Interface Cards on Right -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>  <!-- Left: Real-Time Dual-Series Bandwidth Graph & Info -->
                        <ColumnDefinition Width="*"/>      <!-- Right: Scrollable Network Adapters -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: SYSTEM NETWORK BANDWIDTH GRAPH -->
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Real-Time Bandwidth Waveform Graph -->
                        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                            <Grid>
                                <DockPanel VerticalAlignment="Top" Margin="4,0,4,0">
                                    <TextBlock Text="NETWORK BANDWIDTH THROUGHPUT" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Down: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock x:Name="TxtNetGraphDownVital" Text="0.0 KB/s" Foreground="{DynamicResource BrushMetricRed}" FontWeight="Bold" FontFamily="Consolas" FontSize="10" Margin="0,0,10,0"/>
                                        <TextBlock Text="Up: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock x:Name="TxtNetGraphUpVital" Text="0.0 KB/s" Foreground="{DynamicResource BrushMetricGreen}" FontWeight="Bold" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </DockPanel>
                                <Canvas x:Name="CanvasNetworkGraph" Margin="0,18,0,18" Background="Transparent" ClipToBounds="True"/>
                                <Grid VerticalAlignment="Bottom" Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="-60s" Foreground="#6E7681" FontSize="9" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="-30s" Foreground="#6E7681" FontSize="9" FontFamily="Consolas" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Now" Foreground="#6E7681" FontSize="9" FontFamily="Consolas" TextAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Network Protocol Diagnostics Card -->
                        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="NETWORK INTERFACE SUMMARY" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10.5" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Active Interfaces: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock x:Name="TxtActiveNicCount" Text="0 Active" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="11" FontFamily="Consolas"/>
                                        <TextBlock Text="Default Gateway: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtDefaultGateway" Text="--" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas" FontSize="10.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Total Link Capacity: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock x:Name="TxtTotalLinkSpeed" Text="-- Mbps" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="11" FontFamily="Consolas"/>
                                        <TextBlock Text="DNS Resolver: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtDnsServers" Text="--" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- RIGHT COLUMN: DYNAMIC LIST OF NETWORK ADAPTER CARDS -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="2,0,2,8">
                                <TextBlock Text="ALL NETWORK INTERFACES" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11"/>
                                <TextBlock x:Name="TxtInterfacesTotalCount" Text="0 Adapters" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10.5"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelNetworkAdapters">
                                    <!-- Populated dynamically with rich interface cards -->
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 6: PROCESSES & TOP APPS -->
            <Grid x:Name="ViewProcesses" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top 4 Leaderboard Cards: CPU, GPU, RAM, Net -->
                    <RowDefinition Height="*"/>    <!-- Full Interactive Process Matrix -->
                </Grid.RowDefinitions>

                <!-- 1. TOP 4 LEADERBOARD CARDS (TOP 3 PER RESOURCE) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: TOP 3 CPU CONSUMERS -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Effect="{DynamicResource SkeuoCardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                    <TextBlock Text="CPU" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource BrushAccentCobalt}"/>
                                </Border>
                                <TextBlock Text="TOP 3 CPU LOAD" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10.5" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelTopCpu">
                                <!-- Populated dynamically -->
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: TOP 3 GPU CONSUMERS -->
                    <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Effect="{DynamicResource SkeuoCardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                    <TextBlock Text="GPU" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource BrushAccentCobalt}"/>
                                </Border>
                                <TextBlock Text="TOP 3 GPU LOAD" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10.5" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelTopGpu">
                                <!-- Populated dynamically -->
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: TOP 3 RAM (WORKING SET) CONSUMERS -->
                    <Border Grid.Column="4" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Effect="{DynamicResource SkeuoCardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                    <TextBlock Text="RAM" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource BrushAccentCobalt}"/>
                                </Border>
                                <TextBlock Text="TOP 3 RAM (WORKING SET)" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10.5" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelTopRam">
                                <!-- Populated dynamically -->
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: TOP 3 INTERNET & NETWORK CONSUMERS -->
                    <Border Grid.Column="6" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Effect="{DynamicResource SkeuoCardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                    <TextBlock Text="NET" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource BrushAccentCobalt}"/>
                                </Border>
                                <TextBlock Text="BANDWIDTH LEADERS" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10.5" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelTopNet">
                                <!-- Populated dynamically -->
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. FULL LIVE PROCESS MATRIX (SEARCH & SORT) -->
                <Border Grid.Row="1" Background="{DynamicResource BrushPanelBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Effect="{DynamicResource SkeuoCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Search Box & Process Counter -->
                            <RowDefinition Height="*"/>    <!-- DataGrid -->
                        </Grid.RowDefinitions>

                        <!-- Search & Controls Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PROCESS OBSERVABILITY MATRIX" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtProcessCount" Text="0 Active Processes" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Search Box -->
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource BrushCardSunken}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Width="260">
                                <TextBox x:Name="TxtProcessFilter" Text="Filter processes (e.g. chrome, code)..." TextChanged="TxtProcessFilter_TextChanged" GotFocus="TxtProcessFilter_GotFocus" LostFocus="TxtProcessFilter_LostFocus" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>

                        <!-- Live DataGrid -->
                        <DataGrid Grid.Row="1" x:Name="GridAllProcesses" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushGridLine}" Background="Transparent" BorderThickness="0" Sorting="GridAllProcesses_Sorting" RowHeight="24" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding FormattedPid}" SortMemberPath="Pid" Width="80" MinWidth="45" MaxWidth="120"/>
                                <DataGridTextColumn Header="PROCESS NAME" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding FormattedCpu}" Width="75" MinWidth="55" MaxWidth="120"/>
                                <DataGridTextColumn Header="GPU %" Binding="{Binding FormattedGpu}" Width="75" MinWidth="55" MaxWidth="120"/>
                                <DataGridTextColumn Header="WORKING SET" Binding="{Binding FormattedWorkingSet}" Width="105" MinWidth="75" MaxWidth="160"/>
                                <DataGridTextColumn Header="PRIVATE RAM" Binding="{Binding FormattedPrivateMemory}" Width="105" MinWidth="75" MaxWidth="160"/>
                                <DataGridTextColumn Header="NET DOWN" Binding="{Binding FormattedNetDown}" Width="100" MinWidth="75" MaxWidth="160"/>
                                <DataGridTextColumn Header="NET UP" Binding="{Binding FormattedNetUp}" Width="95" MinWidth="70" MaxWidth="160"/>
                                <DataGridTextColumn Header="THREADS" Binding="{Binding ThreadCount}" Width="70" MinWidth="50" MaxWidth="100"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80" MinWidth="60" MaxWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 7: TRAY BADGE CONFIG -->
            <Grid x:Name="ViewTray" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        
                        <!-- Top Active Silicon Detection Cards -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU Detection Card -->
                            <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="12" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="DETECTED CPU SILICON" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtDetectedCpuName" Text="CPU" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Vendor Architecture: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                        <Border x:Name="BrdCpuVendorBadge" Background="#0284C7" CornerRadius="10" Padding="6,2" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtCpuVendorLabel" Text="Intel (#0284C7)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- GPU Detection Card -->
                            <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="12" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="DETECTED GPU SILICON" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtDetectedGpuName" Text="GPU" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Vendor Architecture: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                        <Border x:Name="BrdGpuVendorBadge" Background="#16A34A" CornerRadius="10" Padding="6,2" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtGpuVendorLabel" Text="NVIDIA (#16A34A)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tray Sensors & Color Customizer Table -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="16" CornerRadius="12" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="TASKBAR TRAY SENSOR BADGES &amp; PALETTE CUSTOMIZATION" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnResetVendorColors" Content="Restore Vendor Defaults" Click="BtnResetVendorColors_Click" 
                                            HorizontalAlignment="Right" Style="{StaticResource TechButton}" Padding="8,3"/>
                                </Grid>

                                <!-- Table Header -->
                                <Grid Background="{DynamicResource BrushCardSunken}" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ON" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Padding="6,4"/>
                                    <TextBlock Grid.Column="1" Text="TELEMETRY SENSOR" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Padding="6,4"/>
                                    <TextBlock Grid.Column="2" Text="AUTO VENDOR PALETTE" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Padding="6,4"/>
                                    <TextBlock Grid.Column="3" Text="HEX COLOR" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Padding="6,4"/>
                                    <TextBlock Grid.Column="4" Text="PREVIEW" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Padding="6,4"/>
                                </Grid>

                                <!-- Row 1: CPU Temp -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkTrayCpuTemp" Click="ChkTray_Changed" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="CPU Package Temp (°C)" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtAutoCpuTemp" Text="Intel Sky Blue (#0284C7)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" x:Name="TxtHexCpuTemp" Text="#0284C7" TextChanged="TxtHexColor_Changed" Width="85" HorizontalAlignment="Left" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{DynamicResource BrushCardBorder}" FontFamily="Consolas" Padding="4,2"/>
                                    <Border Grid.Column="4" x:Name="PvwCpuTemp" Background="#0284C7" Width="28" Height="18" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row 2: GPU Temp -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkTrayGpuTemp" Click="ChkTray_Changed" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="GPU Core Temp (°C)" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtAutoGpuTemp" Text="NVIDIA Green (#16A34A)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" x:Name="TxtHexGpuTemp" Text="#16A34A" TextChanged="TxtHexColor_Changed" Width="85" HorizontalAlignment="Left" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{DynamicResource BrushCardBorder}" FontFamily="Consolas" Padding="4,2"/>
                                    <Border Grid.Column="4" x:Name="PvwGpuTemp" Background="#16A34A" Width="28" Height="18" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row 3: CPU Power -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkTrayCpuPower" Click="ChkTray_Changed" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="CPU Package Power (Watts)" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtAutoCpuPower" Text="Intel Royal Blue (#1E40AF)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" x:Name="TxtHexCpuPower" Text="#1E40AF" TextChanged="TxtHexColor_Changed" Width="85" HorizontalAlignment="Left" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{DynamicResource BrushCardBorder}" FontFamily="Consolas" Padding="4,2"/>
                                    <Border Grid.Column="4" x:Name="PvwCpuPower" Background="#1E40AF" Width="28" Height="18" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row 4: GPU Power -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkTrayGpuPower" Click="ChkTray_Changed" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="GPU Board Power (Watts)" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtAutoGpuPower" Text="NVIDIA Forest (#14532D)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" x:Name="TxtHexGpuPower" Text="#14532D" TextChanged="TxtHexColor_Changed" Width="85" HorizontalAlignment="Left" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{DynamicResource BrushCardBorder}" FontFamily="Consolas" Padding="4,2"/>
                                    <Border Grid.Column="4" x:Name="PvwGpuPower" Background="#14532D" Width="28" Height="18" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row 5: Total System Power -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkTraySystemPower" Click="ChkTray_Changed" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="Total System Power (Watts)" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Dark Slate (#0F172A)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" x:Name="TxtHexSysPower" Text="#0F172A" TextChanged="TxtHexColor_Changed" Width="85" HorizontalAlignment="Left" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{DynamicResource BrushCardBorder}" FontFamily="Consolas" Padding="4,2"/>
                                    <Border Grid.Column="4" x:Name="PvwSysPower" Background="#0F172A" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Width="28" Height="18" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row 6: Battery Remaining -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="ChkTrayBattery" Click="ChkTray_Changed" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="Battery % or Runtime Remaining" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Charcoal / Green AC (#334155)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" x:Name="TxtHexBattery" Text="#334155" TextChanged="TxtHexColor_Changed" Width="85" HorizontalAlignment="Left" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{DynamicResource BrushCardBorder}" FontFamily="Consolas" Padding="4,2"/>
                                    <Border Grid.Column="4" x:Name="PvwBattery" Background="#334155" Width="28" Height="18" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Window & Taskbar Preferences -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="16" CornerRadius="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="STARTUP &amp; WINDOW BEHAVIOR" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkStartWithWindows" Click="ChkStartWithWindows_Click" Content="Start Clocky automatically on Windows boot" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkStartMinimized" Click="ChkStartMinimized_Click" Content="Start minimized to system tray on launch" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkCloseToTray" Click="ChkCloseToTray_Click" Content="Close button (X) minimizes to tray" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkMinimizeToTray" Click="ChkMinimizeToTray_Click" Content="Minimize button (-) hides to tray" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkAlwaysOnTopOption" Click="ChkAlwaysOnTopOption_Click" Content="Always on top" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkEnableDebugLog" Click="ChkEnableDebugLog_Click" Content="Enable debug logging (app_debug.log)" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>

                                <Button x:Name="BtnSaveTrayConfig" Content="Refresh Taskbar Badges" Click="BtnSaveTrayConfig_Click" Width="180" HorizontalAlignment="Left" 
                                        Style="{StaticResource TechButton}" Padding="12,6"/>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Updater & Version Management -->
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="16" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="APPLICATION UPDATES" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkAutoCheckUpdates" Click="ChkAutoCheckUpdates_Click" Content="Automatically check for updates on startup" IsChecked="True" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnCheckUpdatesNow" Content="Check for Updates Now" Click="BtnCheckUpdatesNow_Click" Style="{StaticResource TechButton}" Padding="14,6" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtUpdateStatus" Text="Clocky v1.0.0 (Release) • Standalone" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>

            <!-- 3. BOTTOM SKEUOMORPHIC STATUS & SHORTCUT LEGEND -->
            <Border Grid.Row="2" Background="{DynamicResource BrushPanelBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,10,0,0" Effect="{DynamicResource SkeuoButtonShadow}">
                <DockPanel LastChildFill="True">
                    <!-- Left: Telemetry Engine Diagnostics -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Clocky v1.0 • PID: " FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock x:Name="TxtPid" Text="--" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,14,0"/>
                        <TextBlock Text="Active Sensors: " FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock x:Name="TxtSensorsCount" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Right: Polling Timestamp -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Last Polled: " FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock x:Name="TxtLastUpdated" Text="--" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Center: Update Notification Badge (Visible when update is staged) -->
                    <Border x:Name="BadgeUpdateAvailable" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#5865F2" CornerRadius="12" Padding="10,3" Cursor="Hand" MouseLeftButtonDown="BadgeUpdateAvailable_Click">
                        <TextBlock x:Name="TxtUpdateBadge" Text="Update Available (Click to Restart)" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>